# Copy to .env and replace every placeholder.
DOMAIN=analytics.example.ru
ACME_EMAIL=admin@example.ru
POSTGRES_DB=ozon_analytics
POSTGRES_USER=ozon_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DASHBOARD_USERNAME=REPLACE_WITH_UNIQUE_LOGIN
DASHBOARD_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Generate a persistent Fernet-compatible key; do not rotate casually.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
# Generate a long random one-time token; remove after first-owner bootstrap.
BOOTSTRAP_TOKEN=REPLACE_WITH_LONG_RANDOM_ONE_TIME_TOKEN
# Keep empty until tenant isolation is complete and reviewed.
OZON_CLIENT_ID=
OZON_API_KEY=
