# Keep "openai" unless you intentionally configure another provider.
AI_PROVIDER=openai
# Optional override. Defaults: OpenAI gpt-4.1-mini; Gemini gemini-3.1-flash-lite-preview; Groq openai/gpt-oss-20b; OpenRouter openrouter/free
AI_MODEL=

# Add only the key for the selected provider. Never commit real keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Legacy OpenAI model override (used only when AI_MODEL is empty and provider=openai).
OPENAI_MODEL=gpt-4.1-mini

APP_USER=lilu
APP_PASSWORD=replace-with-a-long-random-password
PORT=3000
